# Joist backend: production environment.
#
# Copy to `.env` on the host (it is gitignored) and fill in every value.
# Never commit the filled-in file. The full runbook is
# docs/guide/hosting.md.
#
# With NODE_ENV=production the backend refuses to start when:
#   - APP_BASE_URL or FRONTEND_URL is missing or not https://
#   - JWT_SECRET is shorter than 32 bytes
#   - any QB_* or ABC_* variable is set (both use one account for every
#     company on the host)
#   - AUTH_COOKIE_CROSS_SITE=true or TRUST_PROXY=true

NODE_ENV=production

# Listen on loopback only. Browsers reach the API through the frontend's
# /api rewrite on the same host, never directly.
HOST=127.0.0.1
PORT=4000

# postgres://USER:PASSWORD@HOST:5432/DATABASE
# Add ?sslmode=require when the database is on another machine.
DATABASE_URL=

# Generate on the host: openssl rand -hex 32
JWT_SECRET=
# JWT_EXPIRES_IN=7d

# The https:// address people type to reach Joist. Invite links use it.
APP_BASE_URL=
# The same address (the frontend serves the app and proxies /api).
FRONTEND_URL=

# Which hop may supply X-Forwarded-For. The frontend's /api rewrite connects
# from this host, and passes the TLS proxy's X-Forwarded-For through.
# Leave as loopback unless the topology in hosting.md changes.
TRUST_PROXY=loopback

# Uploaded files (photos, documents, logos). Outside the code checkout, so a
# redeploy never touches them; db:backup archives this directory.
UPLOADS_DIR=/var/lib/joist/uploads

# Backups (npm run db:backup, nightly; see "Backups" in hosting.md).
BACKUP_DIR=/var/backups/joist
# Off-host copy: rsync destination over ssh, or a mounted path. Without it
# a production backup exits 2: a copy on the same disk is not a backup.
BACKUP_REMOTE=
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MIN=3
# For npm run db:restore-check, when the app role can't CREATE DATABASE:
# RESTORE_ADMIN_URL=postgresql://postgres@/postgres?host=/var/run/postgresql

# Extra CORS origins, comma separated. Not needed for the same-origin setup.
# CORS_ORIGINS=

# Mail (optional). Without it, invites fall back to a copied link.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Joist <no-reply@example.com>"

# Leave unset on a shared host: QuickBooks (QB_*, ENCRYPTION_KEY) and
# ABC Supply (ABC_*). The boot check refuses QB_* and ABC_* in production.
